# ============================================================================
# Dar-Ul-Kutub - Environment Variables
# Copy this file to .env.local for local development
# ============================================================================

# ============================================================================
# Database
# ============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/dar_ul_kutub?schema=public"

# ============================================================================
# NextAuth.js
# ============================================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# ============================================================================
# Stripe (Payments & Connect)
# ============================================================================
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Platform commission (0.15 = 15%)
PLATFORM_COMMISSION_RATE="0.15"

# ============================================================================
# Shippo (Shipping)
# ============================================================================
# Get from: https://apps.goshippo.com/settings/api
SHIPPO_API_KEY="shippo_test_..."
NEXT_PUBLIC_SHIPPO_PUBLISHABLE_KEY="shippo_test_..."

# ============================================================================
# Resend (Email)
# ============================================================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@dar-ul-kutub.com"

# ============================================================================
# Twilio (SMS - Optional)
# ============================================================================
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# ============================================================================
# File Storage (AWS S3 or Vercel Blob)
# ============================================================================
# Option 1: AWS S3
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="dar-ul-kutub-images"

# Option 2: Vercel Blob (if using Vercel)
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# ============================================================================
# Application Settings
# ============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Dar-Ul-Kutub"

# Vendor invite link expiration (days)
VENDOR_INVITE_EXPIRATION_DAYS="7"

# Magic link expiration (hours)
MAGIC_LINK_EXPIRATION_HOURS="24"

# Default shipping origin (for rate estimates)
DEFAULT_SHIP_FROM_ZIP="10001"

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_SMS_NOTIFICATIONS="false"
ENABLE_PRODUCT_REVIEWS="true"
ENABLE_GUEST_WISHLIST="false"

# ============================================================================
# Monitoring & Analytics (Optional)
# ============================================================================
# Sentry
# SENTRY_DSN="..."

# Vercel Analytics
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID="..."

# ============================================================================
# Development Only
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL="debug"

# Disable email sending in dev (just log to console)
DEV_DISABLE_EMAIL="true"

# Seed database with test data
SEED_TEST_DATA="true"
